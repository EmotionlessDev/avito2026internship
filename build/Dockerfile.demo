# Раннер демо-прогона.
#
# Скрипту нужны bash, curl и jq. Держать их обязательными на машине
# проверяющего не хочется: Docker для стенда и так обязателен, а лишняя
# установка пакетов — лишний повод, чтобы демо «не завелось».
FROM alpine:3.20

RUN apk add --no-cache bash curl jq

WORKDIR /app

ENTRYPOINT ["bash", "/app/scripts/demo.sh"]
