# Копия для локальных переопределений: cp .env.example .env
# Файл не обязателен — в docker-compose.yml у всех переменных есть значения
# по умолчанию, и `docker compose up` работает на чистом клоне.

# --- Приложение ---
APP_ENV=dev              # dev | prod: влияет на формат логов
LOG_LEVEL=info           # debug | info | warn | error
LOG_FORMAT=text          # text (dev) | json (prod)

# --- Postgres ---
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen
POSTGRES_DB=kitchen
POSTGRES_PORT=55432        # порт на хосте; внутри compose всегда 5432
# DSN нужен только для запуска бинарей мимо compose (`go run ./cmd/kitchen-api`).
# Внутри стенда он собирается из переменных выше и указывает на postgres:5432.
POSTGRES_DSN=postgres://kitchen:kitchen@localhost:55432/kitchen?sslmode=disable

# --- Мигратор ---
# true — после миграций стенд наполняется демо-каталогом (3 заведения, 26 позиций).
MIGRATOR_SEED=true

# --- Kafka ---
# Идентификатор кластера KRaft. Фиксированный, чтобы том с данными переживал
# пересоздание контейнера; менять только вместе с `make down` (том сносится).
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_EXTERNAL_PORT=9094
# Адрес брокера для сервисов. Внутри compose — kafka:9092; значение ниже
# нужно только для запуска бинарей с хоста.
KAFKA_BROKERS=localhost:9094

# --- Outbox ---
# Размер пачки и страховочный опрос: основной сигнал приходит через
# LISTEN/NOTIFY, поэтому интервал спокойный.
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=2s
OUTBOX_MAX_ATTEMPTS=5

# --- Swagger UI ---
SWAGGER_UI_PORT=8085

# --- Temporal ---
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
# Адрес движка для сервисов. Внутри compose — temporal:7233.
TEMPORAL_HOSTPORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=kitchen-orders
# Сроки процесса заказа. В демо и e2e их укорачивают, чтобы не ждать
# семь минут; на поведение процесса величина срока не влияет.
ORDER_CONFIRMATION_TIMEOUT=7m
ORDER_COOKING_SLA=30m
ORDER_DELIVERY_SLA=45m

# --- Порты сервисов на хосте ---
KITCHEN_API_PORT=8080
KITCHEN_WORKER_PORT=8081
MERCHANT_POS_PORT=8090
